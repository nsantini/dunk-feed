# Dunk Feed configuration. Every variable is documented in
# docs/TECH-DESIGN.md section 4. Copy this file to `.env` and fill in the
# two required variables before running `cargo run -- run`.

# SQLite file.
DUNK_DB_PATH=/data/dunk.db

# Listen address.
DUNK_HTTP_ADDR=0.0.0.0:3000

# Public hostname, forms did:web:<hostname>. Required, no default.
DUNK_HOSTNAME=

# Your account DID. Forms the feed at-URI. Required, no default.
DUNK_PUBLISHER_DID=

# Record key of the generator record.
DUNK_FEED_RKEY=dunks

# Jetstream host only.
DUNK_JETSTREAM_URL=wss://jetstream.us-east.bsky.network

# App View base URL.
DUNK_APPVIEW_URL=https://public.api.bsky.app

# Score weights: Wr (repost), Wc (reply).
DUNK_W_REPOST=2.0
DUNK_W_REPLY=0.5

# Smoothing constant.
DUNK_K=5

# Popularity floor.
DUNK_P=50

# Dunk margin.
DUNK_M=1.25

# Unpromoted pair lifetime and re-verify horizon, in hours.
DUNK_CANDIDATE_TTL_H=48

# Promoted item lifetime, in days.
DUNK_FEED_TTL_D=30

# Scorer tick interval, in seconds.
DUNK_SCORER_INTERVAL_S=60

# Re-verify interval for promoted pairs under 48 h old, in seconds.
DUNK_REVERIFY_INTERVAL_S=600

# Follower guard, section 9. 0 disables it.
DUNK_FOLLOWER_FLOOR=2000

# Comma-separated label values that drop a pair. Section 9.
DUNK_DROP_LABELS=porn,sexual,graphic-media,nudity,!hide,!warn,spam

# Local E must reach P * fraction before an App View call.
DUNK_PREFILTER_FRACTION=0.5

# Verifier rate limit, requests per second.
DUNK_APPVIEW_RPS=1.0

# tracing filter.
DUNK_LOG=info

# Bluesky app password login, publish only. Never read by run.
BSKY_HANDLE=
BSKY_APP_PASSWORD=
