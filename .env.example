# Upstaged configuration. Every variable is documented in
# docs/01-TECH-DESIGN.md section 4. The binary reads the process environment
# only; it does not load this file itself. Docker Compose passes a copy of
# it named `.env` to the container as its `env_file` (TECH-DESIGN section
# 13). To run locally without Compose, fill in the two required variables
# below and export each line before `cargo run -- run`, for example:
#   export $(grep -v '^#' .env.example | xargs) && cargo run -- run

# SQLite file.
UPSTAGE_DB_PATH=/data/upstage.db

# Listen address.
UPSTAGE_HTTP_ADDR=0.0.0.0:3000

# Public hostname, forms did:web:<hostname>. Required, no default.
UPSTAGE_HOSTNAME=

# Your account DID. Forms the feed at-URI. Required, no default.
UPSTAGE_PUBLISHER_DID=

# Record key of the generator record.
UPSTAGE_FEED_RKEY=upstaged

# Comma-separated Jetstream host list, no path. The client rotates to the
# next host on every failed connect.
UPSTAGE_JETSTREAM_URL=wss://jetstream.us-east.bsky.network,wss://jetstream.us-west.bsky.network

# App View base URL.
UPSTAGE_APPVIEW_URL=https://public.api.bsky.app

# Score weights: Wr (repost), Wc (reply).
UPSTAGE_W_REPOST=2.0
UPSTAGE_W_REPLY=0.5

# Smoothing constant.
UPSTAGE_K=5

# Popularity floor.
UPSTAGE_P=50

# Upstage margin.
UPSTAGE_M=1.25

# Unpromoted pair lifetime and re-verify horizon, in hours.
UPSTAGE_CANDIDATE_TTL_H=48

# Promoted item lifetime, in days.
UPSTAGE_FEED_TTL_D=30

# Scorer tick interval, in seconds.
UPSTAGE_SCORER_INTERVAL_S=60

# Re-verify interval for promoted pairs under 48 h old, in seconds.
UPSTAGE_REVERIFY_INTERVAL_S=600

# Follower guard, section 9. 0 disables it.
UPSTAGE_FOLLOWER_FLOOR=2000

# Comma-separated label values that drop a pair. Section 9. Empty or
# blank is invalid; disabling every label guard is not supported here.
UPSTAGE_DROP_LABELS=porn,sexual,graphic-media,nudity,!hide,!warn,spam

# Local E must reach P * fraction before an App View call.
UPSTAGE_PREFILTER_FRACTION=0.5

# Verifier rate limit, requests per second.
UPSTAGE_APPVIEW_RPS=1.0

# The PDS every session, App View proxy call, and publish write goes
# against. Must be an https origin only: scheme, host, and an optional port,
# with no path other than a bare /, and no userinfo, query or fragment; a
# bare scheme, http://, a path like /xrpc, or a copy-pasted URL with an
# embedded password or tracking query string is rejected at startup.
UPSTAGE_PDS_URL=https://bsky.social

# Graph client rate limit, requests per second. Applies to get_follows and
# get_relationships, and to the session, uploadBlob and putRecord calls that
# share the same PdsClient. Must be positive and finite, with a period (1 /
# rate) between 1 nanosecond and 1 day.
UPSTAGE_GRAPH_RPS=8.0

# tracing filter.
UPSTAGE_LOG=info

# /healthz's lag threshold, in seconds. Past this age on either the last
# Jetstream commit or the last scorer pass, /healthz returns 503. 0 is
# invalid.
UPSTAGE_HEALTH_MAX_LAG_S=300

# Hours the follower-floor histogram period stays open before the pass
# line stops logging a distribution. Section 9. 0 disables the period; the
# floor itself is always live from the first pass regardless.
UPSTAGE_GUARD_HISTOGRAM_H=24

# Hours an authors cache row stays fresh before the guard refetches it, for
# an active row or one carrying a !takedown label. Section 9. 0 is invalid:
# it would refetch every DID on every pass.
UPSTAGE_AUTHOR_TTL_H=24

# Hours a row written active=false from a missing profile (no !takedown
# label) stays fresh before the guard refetches it. Section 9. Shorter than
# UPSTAGE_AUTHOR_TTL_H, since a deactivation is often temporary. 0 is invalid.
UPSTAGE_AUTHOR_INACTIVE_TTL_H=1

# graph-probe only (story 03). Ranked items step_follows_me checks, and the
# depth the connection filter keeps a follows_me-only author at. 0 is invalid.
UPSTAGE_FOLLOWS_ME_DEPTH=1000

# graph-probe only (story 03). DIDs step_follows samples into d2_sample for
# step_degree2 to expand. 0 is invalid.
UPSTAGE_D2_FOLLOWS_SAMPLE=100

# graph-probe only (story 03). getFollows page limit step_degree2 requests
# for each degree-2 account. 0 is invalid.
UPSTAGE_D2_FOLLOWS_DEPTH=100

# Bluesky app password login, publish only. Never read by run.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Cloudflare Tunnel variant only (compose.yaml's cloudflared service).
# src/config.rs never reads this.
TUNNEL_TOKEN=
