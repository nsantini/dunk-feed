        "langs": [
          "en"
        ],
        "text": "Software developers think \"if AI automates coding, I will be able to spend less time on producing widgets, and more time on strategy and architecture.\"\n\nBosses think \"if AI automates coding, I can get my devs to produce 100x more widgets.\""
      },
      "embed": {
        "record": {
          "uri": "at://did:plc:ofzkhjyyh4kl4a35wxgmobmm/app.bsky.feed.post/3mvxb5n76u22b",
