            "images": [
              {
                "$type": "app.bsky.embed.images#image",
                "alt": "Toad stumbles along, draped in melting despair\u2014his ice cream now more curse than treat.\n\nFrom \"Ice Cream\"\nIn *Frog and Toad All Year*",
                "aspectRatio": {
                  "$type": "app.bsky.embed.defs#aspectRatio",
                  "height": 1056,
                  "width": 682
                },
                "image": {
